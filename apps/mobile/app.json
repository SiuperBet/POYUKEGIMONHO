{
  "expo": {
    "name": "POYUKEGIMONHO",
    "slug": "poyukegimonho",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "poyukegimonho",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siuperbet.poyukegimonho",
      "infoPlist": {
        "NSCameraUsageDescription": "Usiamo la fotocamera per scansionare le carte.",
        "NSMotionUsageDescription": "Usiamo i sensori di orientamento per mantenere la carta allineata."
      }
    },
    "android": {
      "package": "com.siuperbet.poyukegimonho",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [],
    "newArchEnabled": true
  }
}
